{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Serenity tests",
      "type": "shell",
      "command": "mvn test -DskipTests=false",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
